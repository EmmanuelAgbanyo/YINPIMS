{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "auth": {
    "authorizedDomains": [
      "localhost",
      "yinpims.firebaseapp.com",
      "yinpims.web.app",
      "yinpims.vercel.app"
    ],
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "YIN-PIMS",
        "supportEmail": "policyp28@gmail.com"
      }
    }
  }
}
